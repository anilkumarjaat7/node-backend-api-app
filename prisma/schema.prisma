generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  des       String
  imgUrl    String
  fees      Float
  duration  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Placement {
  id          Int      @id @default(autoincrement())
  studentName String
  imageUrl    String
  companyName String
  package     Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}